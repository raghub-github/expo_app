# =============================================================================
# GatiMitra Monorepo – Environment variables reference
# =============================================================================
# Copy the sections you need into each app's .env or .env.local.
# Never commit real .env files. Use this file as a template only.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND (backend/.env or backend/.env.local)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public API URL (optional; used in OpenAPI docs)
API_BASE_URL=http://localhost:3000

# Database – use Supabase pooler (port 6543) for app runtime
# postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase (required)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_min_20_chars

# MSG91 – SMS OTP (optional)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY_SEC=300

# Firebase Admin – dev Firebase Phone Auth (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Webhooks (optional)
WEBHOOK_SIGNING_SECRET=

# Cloudflare R2 (optional)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com
# Legacy / alternate
R2_TOKEN_VALUE=

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# CUSTOMER APP – Expo (apps/customer_app/.env or .env.local)
# Only EXPO_PUBLIC_* are included in the app bundle.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# -----------------------------------------------------------------------------
# DASHBOARD – Next.js (dashboard/.env.local)
# -----------------------------------------------------------------------------
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (migrations / server)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Optional fallback
NEXT_PUBLIC_DATABASE_URL=

# Mapbox (maps)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
# Alternate name used in some components
MAPBOX_PUBLIC_TOKEN=

# Ticket attachments (merchant app proxy + R2)
NEXT_PUBLIC_MERCHANT_ATTACHMENT_PROXY=https://your-merchant-app.com
NEXT_PUBLIC_MERCHANT_R2_BASE_URL=https://your-r2-public-domain.com

# R2 (dashboard uploads / rider documents)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rider-documents
R2_REGION=auto
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Feature flags (optional)
USE_ORDERS_CORE=false

# -----------------------------------------------------------------------------
# MERCHANT DB / MERCHANT APP – Next.js (merchant_db/.env.local)
# -----------------------------------------------------------------------------
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Platform branding (optional)
NEXT_PUBLIC_PLATFORM_LOGO_URL=

# Phone OTP (optional)
NEXT_PUBLIC_ENABLE_PHONE_OTP_REGISTER=false
NEXT_PUBLIC_ENABLE_PHONE_OTP_LOGIN=false

# Cloudflare R2 (uploads)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com

# Razorpay (payments / bank verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=

# Onboarding JWT (merchant onboarding token)
ONBOARD_JWT_SECRET=your_onboard_jwt_secret_change_in_production
