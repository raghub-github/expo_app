{
  "name": "@gatimitra/queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./producer": {
      "types": "./dist/producer.d.ts",
      "default": "./dist/producer.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./topics": {
      "types": "./dist/topics.d.ts",
      "default": "./dist/topics.js"
    }
  },
  "dependencies": {
    "@gatimitra/redis": "*",
    "bullmq": "^5.34.5",
    "ioredis": "^5.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'TODO: shared eslint'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@gatimitra/shared-config": "*",
    "typescript": "^5.9.2",
    "@types/node": "^22.10.5"
  }
}
