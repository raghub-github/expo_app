{
  "name": "@gatimitra/logger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "default": "./dist/sentry.js"
    }
  },
  "dependencies": {
    "pino": "^9.9.5"
  },
  "peerDependencies": {
    "@sentry/node": "*"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'TODO'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@gatimitra/shared-config": "*",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.2"
  }
}
