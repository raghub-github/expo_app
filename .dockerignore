# Repo-wide docker context exclusions.
# Every service Dockerfile uses `context: ../..` from infra/docker/, so this
# applies to ALL builds. Keeps Docker context small (otherwise the daemon
# tarballs ~3GB of mobile + dashboard node_modules every time).

# ── Heavy dependency dirs ────────────────────────────────────────────────
**/node_modules
**/.next
**/dist
**/build
**/out
**/.turbo
**/coverage
**/.tsbuildinfo
**/*.tsbuildinfo

# ── Mobile apps (never deployed to VPS) ──────────────────────────────────
apps/customer_app
apps/merchant_app
apps/gatimitra-riderApp

# ── Test artefacts & local caches ────────────────────────────────────────
.cache
.eslintcache
.parcel-cache
.pnpm-store
.npm

# ── Logs ─────────────────────────────────────────────────────────────────
**/*.log
**/logs

# ── Env files (passed in via env_file: at runtime, not baked in) ─────────
**/.env
**/.env.*
!**/.env.example
!**/env.example

# ── Git, IDE, OS ─────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.cursor
.claude
**/.DS_Store
**/Thumbs.db
*.swp
*.swo

# ── Docs / READMEs (image doesn't need them) ─────────────────────────────
**/*.md
!backend/README.md

# ── Infra files don't need to be in app images ──────────────────────────
infra/monitoring
infra/nginx

# ── Misc dev files ──────────────────────────────────────────────────────
docs
agent-transcripts
**/archive-output
*.tmp
tmp
temp

# ── Whitelisted assets needed by cxsite Dockerfile ───────────────────────
# cxsite's prebuild reads apps/customer_app/legal/*.md as the source-of-
# truth for every legal page (one bundle for both web + app). These two
# `!`-rules override (a) the apps/customer_app exclusion and (b) the
# **/*.md exclusion above. Order matters — must be after both.
!apps/customer_app/legal
!apps/customer_app/legal/*.md

# Partnersite prerenders /coc, /terms, /privacy etc. from
# partnersite/src/content/legal/*.md at `next build` time. Without this
# override those pages fail with ENOENT during the prerender step.
!partnersite/src/content/legal
!partnersite/src/content/legal/*.md
