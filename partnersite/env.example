# Partnersite local dev — copy to `.env.local`
#
# Port layout (do not collide):
#   Partnersite      → http://127.0.0.1:3002  (cd partnersite && npm run dev)
#   Dashboard        → http://127.0.0.1:3001  (cd dashboard && npm run dev)
#   Fastify backend  → http://127.0.0.1:3000  (cd backend && npm run dev)
#
# Legacy :4000 / :30000 backend URLs are auto-mapped to :3000 in dev-backend-url.js.

# Full URL recommended; host-only values (api.gatimitra.com) get https:// automatically.
GATIMITRA_BACKEND_API_URL=http://127.0.0.1:3000
# Must match backend BACKEND_SCHEDULE_TICK_SECRET (schedule-tick + sync-acceptance-timeout)
BACKEND_SCHEDULE_TICK_SECRET=
NEXTAUTH_URL=http://localhost:3002

# Cashfree Verification Suite (bank/UPI verification — NOT Razorpay)
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=v2
