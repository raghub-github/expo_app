# Copy to .env.production and set values. Never commit .env.production.

NODE_ENV=production

# Next.js
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Required for Google OAuth redirect on production (baked into client bundle at build time)
NEXT_PUBLIC_APP_URL=https://partner.gatimitra.com
NEXT_PUBLIC_PARTNER_SITE_URL=https://partner.gatimitra.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# R2 / S3 (if used)
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=

# Database (if direct Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Fastify API (schedule tick, acceptance-timeout sync, partner status, weather, ETA, browser push)
GATIMITRA_BACKEND_API_URL=https://api.gatimitra.com
# Same value as backend BACKEND_SCHEDULE_TICK_SECRET (X-Internal-Secret)
BACKEND_SCHEDULE_TICK_SECRET=

# Browser push (Firebase Web + VAPID) — required for Partner Site notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Add other app env vars (Razorpay, MSG91, etc.) as required.
