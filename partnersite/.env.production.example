# Copy to .env.production and set values. Never commit .env.production.

NODE_ENV=production

# Next.js
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# R2 / S3 (if used)
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=

# Database (if direct Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Add other app env vars (Razorpay, MSG91, etc.) as required.
