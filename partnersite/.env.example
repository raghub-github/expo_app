# partnersite — copy to .env.local for dev OR .env.production for prod.
# Keep .env.local / .env.production OUT of git.

NODE_ENV=development
APP_NAME=GatiMitra Partner Portal

# ── Public (baked into client JS at build time by Next) ──────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
NEXT_PUBLIC_ENABLE_PHONE_OTP_LOGIN=true
NEXT_PUBLIC_ENABLE_PHONE_OTP_REGISTER=true
NEXT_PUBLIC_DISABLE_CURRENT_LOCATION=false

# ── Server-only (never sent to browser) ──────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SEND_SMS_HOOK_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
MAPBOX_PUBLIC_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# next-auth — partnersite uses credentials + Google OAuth
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Outbound email (Zoho / SMTP — see partnersite/src/lib/supabase.ts notes)
EMAIL_ID=support@example.com
EMAIL_APP_PASSWORD=
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME=GatiMitra
