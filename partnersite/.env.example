# partnersite â€” copy to .env.local for dev OR .env.production for prod.
# Keep .env.local / .env.production OUT of git.

NODE_ENV=development
APP_NAME=GatiMitra Partner Portal

# â”€â”€ Public (baked into client JS at build time by Next) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Optional: HTTPS URL Cashfree DigiLocker redirects to after consent.
# Required shape is https://â€¦ â€” http://localhost is auto-upgraded to https://
# by the verify-document API / backend. Override when you have a public tunnel.
# Client also appends ?return=<current docs URL> so verify returns to the same page.
# CASHFREE_DIGILOCKER_REDIRECT_URL=https://partner.gatimitra.com/auth/digilocker-return

NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
NEXT_PUBLIC_ENABLE_PHONE_OTP_LOGIN=true
NEXT_PUBLIC_ENABLE_PHONE_OTP_REGISTER=true
NEXT_PUBLIC_DISABLE_CURRENT_LOCATION=false

# â”€â”€ Server-only (never sent to browser) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# REQUIRED for the Supabase send-sms / send-email hooks. Without it those
# routes refuse to send (500) rather than accepting unverified payloads.
SUPABASE_SEND_SMS_HOOK_SECRET=
SUPABASE_SEND_EMAIL_HOOK_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
MAPBOX_PUBLIC_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# next-auth â€” partnersite uses credentials + Google OAuth
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-side Fastify backend (schedule tick, acceptance-timeout sync, weather, ETA recalc,
# partner browser push token registration â†’ /v1/notifications/browser-tokens)
GATIMITRA_BACKEND_API_URL=http://10.150.65.181:3000
# Shared secret with backend BACKEND_SCHEDULE_TICK_SECRET (header X-Internal-Secret).
# Used by partnersite for:
#   POST /v1/internal/stores/:id/schedule-tick
#   POST /v1/internal/stores/:id/sync-acceptance-timeout
#   GET  /v1/internal/stores/:id/partner-status
#   POST /v1/notifications/browser-tokens (via /api/notifications/browser-tokens proxy)
#   POST /v1/auth/internal/merchant/partner-handoff/redeem (merchant app â†’ Add Store SSO)
BACKEND_SCHEDULE_TICK_SECRET=

# â”€â”€ Browser push (Partner Portal web FCM) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Firebase Console â†’ Project settings â†’ Your apps â†’ Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console â†’ Cloud Messaging â†’ Web Push certificates â†’ Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Outbound email (Zoho / SMTP â€” see partnersite/src/lib/supabase.ts notes)
EMAIL_APP_PASSWORD=
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME=GatiMitra
