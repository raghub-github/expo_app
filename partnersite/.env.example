# partnersite — copy to .env.local for dev OR .env.production for prod.
# Keep .env.local / .env.production OUT of git.

NODE_ENV=development
APP_NAME=GatiMitra Partner Portal

# ── Public (baked into client JS at build time by Next) ──────────────────
# Optional: HTTPS URL Cashfree DigiLocker redirects to after consent.
# Required shape is https://… — http://localhost is auto-upgraded to https://
# by the verify-document API / backend. Override when you have a public tunnel.
# Client also appends ?return=<current docs URL> so verify returns to the same page.
# CASHFREE_DIGILOCKER_REDIRECT_URL=https://partner.gatimitra.com/auth/digilocker-return

NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
NEXT_PUBLIC_ENABLE_PHONE_OTP_LOGIN=true
NEXT_PUBLIC_ENABLE_PHONE_OTP_REGISTER=true
NEXT_PUBLIC_DISABLE_CURRENT_LOCATION=false

# ── Server-only (never sent to browser) ──────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# REQUIRED for the Supabase send-sms / send-email hooks. Without it those
# routes refuse to send (500) rather than accepting unverified payloads.
SUPABASE_SEND_SMS_HOOK_SECRET=
SUPABASE_SEND_EMAIL_HOOK_SECRET=
# Numbers the send-sms hook never sends a real SMS to (comma-separated, empty = none).
# Also set the same GOOGLE_REVIEW_* / REVIEW_LOGIN_* / RIDER_REVIEW_* as backend —
# armed review phones are skipped automatically (no hardcoding). SMS_BLOCKED_PHONES
# is an extra safeguard (include review numbers in production).
SMS_BLOCKED_PHONES=
# Same review bypass env names as backend (required for Send SMS hook to skip MSG91):
# GOOGLE_REVIEW_MODE=true
# GOOGLE_REVIEW_PHONE=
# GOOGLE_REVIEW_OTP=
# REVIEW_LOGIN_BYPASS_ENABLED=true
# REVIEW_LOGIN_PHONE=
# REVIEW_LOGIN_FIXED_OTP=
# RIDER_REVIEW_LOGIN_BYPASS_ENABLED=true
# RIDER_REVIEW_LOGIN_PHONE=
# RIDER_REVIEW_LOGIN_FIXED_OTP=
# Per-phone OTP SMS limits for the send-sms hook
# (defaults: 60 s cooldown / 3 per 15m / 5 per hour / 15 per day).
# OTP_SEND_MIN_INTERVAL_SEC=60
# OTP_SEND_15M_CAP=3
# OTP_SEND_1H_CAP=5
# OTP_SEND_DAILY_CAP=15
# REQUIRED in production multi-instance: same Redis as backend (otp:send:* keys).
# Without REDIS_URL the guard falls back to in-process memory (not shared across replicas).
# REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
MAPBOX_PUBLIC_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN

# next-auth — partnersite uses credentials + Google OAuth
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-side Fastify backend (schedule tick, acceptance-timeout sync, weather, ETA recalc,
# partner browser push token registration → /v1/notifications/browser-tokens)
GATIMITRA_BACKEND_API_URL=http://10.122.138.181:3000
# Shared secret with backend BACKEND_SCHEDULE_TICK_SECRET (header X-Internal-Secret).
# Used by partnersite for:
#   POST /v1/internal/stores/:id/schedule-tick
#   POST /v1/internal/stores/:id/sync-acceptance-timeout
#   GET  /v1/internal/stores/:id/partner-status
#   POST /v1/notifications/browser-tokens (via /api/notifications/browser-tokens proxy)
#   POST /v1/auth/internal/merchant/partner-handoff/redeem (merchant app → Add Store SSO)
BACKEND_SCHEDULE_TICK_SECRET=

# ── Browser push (Partner Portal web FCM) ────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Outbound email (Zoho / SMTP — used by Supabase Send Email hook for signup OTP)
# EMAIL_ID = full Zoho mailbox (same as dashboard). App Password from Zoho Mail → Security.
EMAIL_ID=support@gatimitra.com
EMAIL_APP_PASSWORD=
SMTP_FROM_EMAIL=support@gatimitra.com
SMTP_FROM_NAME=GatiMitra Team
# Custom-domain Zoho typically needs smtppro.zoho.in (or smtppro.zoho.com)
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
# Optional fallback when SMTP fails (same as control dashboard)
RESEND_API_KEY=
RESEND_FROM_EMAIL=GatiMitra <noreply@gatimitra.com>
