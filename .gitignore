# Build artefacts that should never be tracked (audit 2026-06)
# These three directories alone were ~75 MB of accidentally-tracked bytes.
**/.expo-bundle-check/
**/.expo-dev-test/
**/.expo-verify/
**/.expo-verify2/
**/.expo-verify-final/
**/.git.nested-control-panel-backup/
**/archive-output/

# Cursor IDE local indices (NOT source code)
**/cursor/crepe/

# Firebase / FCM credentials — NEVER commit these
serviceAccountKey.json
**/serviceAccountKey.json
**/google-services.json
**/GoogleService-Info.plist

# Local perf/debug workspace — not for commit
.perf-isolation/
backend/scripts/_tmp_*

