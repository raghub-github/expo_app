# Coredash — copy to .env.local
# Prefer syncing secrets from dashboard/.env.local (same Postgres + Supabase + R2).

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Control dashboard (order detail: /order/GMF…) — local `dashboard` app uses port 3001 (3000 = API)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# Shared company database (same DATABASE_URL as dashboard/.env.local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Same Supabase project as the control dashboard (Google OAuth is configured there)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# R2 — same keys as control dashboard (selfies / media)
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_MERCHANT_R2_BASE_URL=
R2_TOKEN_VALUE=
R2_BUCKET_NAME=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=
R2_ENDPOINT=
R2_ACCOUNT_ID=

# Wallet credit OTP (CoreDash → customer GatiCash top-up)
COREDASH_WALLET_OTP_EMAIL=bhimpratap08@gmail.com

# Zoho SMTP (same as dashboard/partnersite) — required to send wallet OTP emails
EMAIL_ID=
EMAIL_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# Optional fallback:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Add BOTH of these to Supabase Auth → Redirect URLs:
#   http://localhost:3004/auth/callback
#   http://localhost:3000/auth/callback  (control dashboard)
