# Coredash — copy to .env.local
# Use the SAME Postgres + Supabase project as the control dashboard.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Shared company database (same DATABASE_URL as dashboard/.env.local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Same Supabase project as the control dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Add http://localhost:3004/auth/callback to Supabase Auth → Redirect URLs
