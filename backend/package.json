{
  "name": "@gatimitra/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx watch src/index.ts",
    "dev:30000": "cross-env PORT=3000 NODE_OPTIONS=--max-old-space-size=4096 tsx watch src/index.ts",
    "dev:4000": "cross-env PORT=3000 NODE_OPTIONS=--max-old-space-size=4096 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(backend) no lint configured\"",
    "test": "node --import tsx/esm --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "audit:order-tables": "tsx scripts/audit-order-tables.ts",
    "db:verify-orders-core": "tsx scripts/verify-orders-core-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/run-sql-migration.ts",
    "db:gen-app-assets-migration": "node scripts/gen-app-assets-migration.mjs",
    "db:upload-app-assets": "node scripts/upload-app-static-assets-r2.mjs",
    "db:migrate:rule-engine": "tsx scripts/run-sql-migration.ts drizzle/0246_gm_financial_rule_engine.sql && tsx scripts/run-sql-migration.ts drizzle/0247_gm_rule_engine_integrations.sql && tsx scripts/run-sql-migration.ts drizzle/0248_gm_execute_rule_finalize_hook.sql",
    "oms:backfill": "tsx scripts/backfill-oms-ledger.ts",
    "oms:reconcile": "tsx scripts/reconcile-oms-ledger.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@gatimitra/bill-print": "*",
    "@gatimitra/contracts": "0.0.1",
    "@gatimitra/event-contracts": "*",
    "@gatimitra/financial-rules": "*",
    "@gatimitra/merchant-payout": "*",
    "@gatimitra/logger": "*",
    "@gatimitra/queue": "*",
    "@gatimitra/redis": "*",
    "@gatimitra/rider-availability": "*",
    "@gatimitra/slab-pricing": "*",
    "@gatimitra/store-status": "*",
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^25.0.3",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^5.0.3",
    "firebase-admin": "^13.10.0",
    "h3-js": "^4.5.0",
    "image-size": "^1.1.1",
    "jose": "^6.1.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.17.1",
    "pino": "^9.9.5",
    "postgres": "^3.4.7",
    "razorpay": "^2.9.2",
    "standardwebhooks": "^1.0.0",
    "ulid": "^2.4.0",
    "ws": "^8.21.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
