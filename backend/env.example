## Backend shared config (example)
## Copy to `backend/.env` OR prefer `backend/.env.local` for machine-specific secrets.

NODE_ENV=development
# Local dev default port (dashboard runs on :3001).
PORT=3000

# Public URL of this API (required in production for customer/mobile apps). Menu and store images are
# stored in the DB as relative /api/attachments/proxy?key=... or /v1/attachments/proxy?key=...; responses
# prepend API_BASE_URL so React Native Image and browsers get an absolute URL.
API_BASE_URL=http://127.0.0.1:3000

# Public live trip share links (optional). When unset, dev uses API_BASE_URL/trip/{token}.
# Production example: https://track.gatimitra.com/trip
# Local LAN example (match API_BASE_URL host):
TRACK_BASE_URL=http://192.168.31.82:3000/trip

# Mapbox — required for live trip tracking map on /trip/:token pages
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Database (required)
# Use POOLER connection (port 6543) for production/application runtime
# Format: postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-REGION.pooler.supabase.com:6543/postgres
# Example: postgresql://postgres.mjfnzmepmeqemcoakjkw:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-REGION.pooler.supabase.com:6543/postgres
# Keep low in dev — Supabase transaction pooler is easy to exhaust (default in code: 6).
# DATABASE_POOL_MAX=6

# Supabase (required)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_MIN_20_CHARS

# MSG91 – OTP SMS (same provider as partnersite). Required for production SMS.
# When set, /v1/auth/otp/request and Supabase Send SMS hook deliver via MSG91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional flow_id — only used when TEMPLATE_ID is unset. Prefer TEMPLATE_ID when both exist.
# MSG91_FLOW_ID=
MSG91_OTP_EXPIRY_SEC=300
MSG91_SENDER_ID=GATMIT
# OTP placeholder in Flow/DLT template (partnersite + backend default: OTP)
MSG91_OTP_VAR_NAME=OTP

# Zoho SMTP – customer email verification OTP (preferred when set)
# Same aliases as dashboard / partnersite welcome emails.
EMAIL_ID=
EMAIL_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GatiMitra Team
# Ride invoice email display name (defaults to GatiMitra - Ride - Services)
RIDE_INVOICE_FROM_NAME=GatiMitra - Ride - Services
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
# Legacy aliases (optional fallback)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase Admin (optional; used for dev Firebase Phone Auth session exchange)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Webhooks (optional)
WEBHOOK_SIGNING_SECRET=

# Cloudflare R2 (optional)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local dev: true = customer checkout uses Simulate Success/Failure (no live Razorpay calls).
PAYMENT_DUMMY_MODE=true

# Redis (optional in local dev — required for ws-gateway realtime + distributed locks in production)
# Local: Memurai or Docker redis on 6379 — run scripts/install-redis-windows.ps1 (Admin)
# If Redis is not running locally, leave REDIS_URL unset or comment it out to avoid connection noise.
REDIS_URL=redis://127.0.0.1:6379
# When true (default in development), cache/locks/pubsub degrade gracefully if Redis is down.
# Set to false in production so missing Redis fails loudly.
REDIS_OPTIONAL=true

# ws-gateway (separate process, port 4100): JWT_SECRET must equal SUPABASE_JWT_SECRET above.
# Run: npm run setup:ws-env  then  npm run dev:ws-gateway

# Dashboard billing simulator (optional): same value as dashboard BILLING_SIM_SECRET (min 16 chars).
# Enables POST /v1/billing/calculate with header x-billing-sim-secret (no customer JWT).
# BILLING_SIM_SECRET=

# OMS v2 rollout flags
# Shadow write immutable snapshot + billing decomposition + payment/refund lifecycle + ledger tables on finalize.
OMS_LEDGER_SHADOW_WRITE=true
# Enforce rider assignment v2 checks on tracking and expose assignment event API.
OMS_RIDER_ASSIGNMENT_V2=true
# Read switch marker for canonical v2 tables (kept false until rollout cutover is complete).
OMS_READ_CANONICAL_V2=false

