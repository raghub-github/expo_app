## Backend shared config (example)
## Copy to `backend/.env` OR prefer `backend/.env.local` for machine-specific secrets.

NODE_ENV=development
# Local dev default port (dashboard runs on :3001).
PORT=3000

# Public URL of this API (required in production for customer/mobile apps). Menu and store images are
# stored in the DB as relative /api/attachments/proxy?key=... or /v1/attachments/proxy?key=...; responses
# prepend API_BASE_URL so React Native Image and browsers get an absolute URL.
API_BASE_URL=http://127.0.0.1:3000

# Public live trip share links (optional). When unset, dev uses API_BASE_URL/trip/{token}.
# Production example: https://track.gatimitra.com/trip
# Local LAN example (match API_BASE_URL host):
TRACK_BASE_URL=http://10.124.175.181:3000/trip

# Mapbox — required for live trip tracking map on /trip/:token pages
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Database (required)
# Use POOLER connection (port 6543) for production/application runtime
# Format: postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-REGION.pooler.supabase.com:6543/postgres
# Example: postgresql://postgres.mjfnzmepmeqemcoakjkw:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-REGION.pooler.supabase.com:6543/postgres
# Postgres pool + HTTP DB slot limit (one slot per in-flight API request). Dev default: 20.
DATABASE_POOL_MAX=20
# Optional: queue wait before 503 when all slots busy (default 25s dev / 12s prod)
# DATABASE_SLOT_ACQUIRE_TIMEOUT_MS=25000

# Supabase (required)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_MIN_20_CHARS

# MSG91 – OTP SMS (same provider as partnersite). Required for production SMS.
# When set, /v1/auth/otp/request and Supabase Send SMS hook deliver via MSG91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional flow_id — only used when TEMPLATE_ID is unset. Prefer TEMPLATE_ID when both exist.
# MSG91_FLOW_ID=
MSG91_OTP_EXPIRY_SEC=300
MSG91_SENDER_ID=GATMIT
# OTP placeholder in Flow/DLT template (partnersite + backend default: OTP)
MSG91_OTP_VAR_NAME=OTP

# Zoho SMTP – customer email verification OTP (preferred when set)
# Same aliases as dashboard / partnersite welcome emails.
EMAIL_ID=
EMAIL_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GatiMitra Team
# Ride invoice email display name (defaults to GatiMitra - Ride - Services)
RIDE_INVOICE_FROM_NAME=GatiMitra - Ride - Services
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
# Legacy aliases (optional fallback)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase Admin — used for BOTH Firebase Auth ID-token verification AND FCM v1.
# Pick ONE of the three credential sources below (singleton picks them in this order):
#
# 1) RECOMMENDED on VPS: path to the service-account JSON file.
#    Drop the file at backend/credentials/serviceAccountKey.json (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./credentials/serviceAccountKey.json
#
# 2) RECOMMENDED on managed PaaS: full JSON as a single-line string.
#    Take backend/credentials/serviceAccountKey.json, paste its full contents here.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"…", …}
#
# 3) LEGACY inline trio (still works; used historically for Firebase Auth only).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Webhooks (optional)
WEBHOOK_SIGNING_SECRET=

# Cloudflare R2 (optional)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local dev: true = customer checkout uses Simulate Success/Failure (no live Razorpay calls).
PAYMENT_DUMMY_MODE=true

# Redis (optional in local dev — required for ws-gateway realtime + distributed locks in production)
# Local: Memurai or Docker redis on 6379 — run scripts/install-redis-windows.ps1 (Admin)
# If Redis is not running locally, leave REDIS_URL unset or comment it out to avoid connection noise.
REDIS_URL=redis://127.0.0.1:6379
# When true (default in development), cache/locks/pubsub degrade gracefully if Redis is down.
# Set to false in production so missing Redis fails loudly.
REDIS_OPTIONAL=true

# ws-gateway (separate process, port 4100): JWT_SECRET must equal SUPABASE_JWT_SECRET above.
# Run: npm run setup:ws-env  then  npm run dev:ws-gateway

# Dashboard billing simulator (optional): same value as dashboard BILLING_SIM_SECRET (min 16 chars).
# Enables POST /v1/billing/calculate with header x-billing-sim-secret (no customer JWT).
# BILLING_SIM_SECRET=

# Internal server-to-server calls from partnersite/dashboard (header X-Internal-Secret):
#   POST /v1/internal/stores/:id/schedule-tick
#   POST /v1/internal/stores/:id/sync-acceptance-timeout
#   GET  /v1/internal/stores/:id/partner-status
  // Set the same value in those apps as BACKEND_SCHEDULE_TICK_SECRET.
BACKEND_SCHEDULE_TICK_SECRET=

# ── Push / Super Admin campaigns ─────────────────────────────────────────
# Default inline Expo delivery (no worker needed). Set PUSH_USE_QUEUE=1 only
# when Redis + `npm run dev:notification-worker` (or prod worker) are running.
PUSH_USE_QUEUE=0
# Treat NotificationService v2 as authoritative for campaign sends.
NOTIFICATIONS_V2_ENABLED=true
# Optional: legacy admin push endpoint shared with dashboard.
# PUSH_NOTIFICATION_ADMIN_SECRET=

# OMS v2 rollout flags
# Shadow write immutable snapshot + billing decomposition + payment/refund lifecycle + ledger tables on finalize.
OMS_LEDGER_SHADOW_WRITE=true
# Enforce rider assignment v2 checks on tracking and expose assignment event API.
OMS_RIDER_ASSIGNMENT_V2=true
# Read switch marker for canonical v2 tables (kept false until rollout cutover is complete).
OMS_READ_CANONICAL_V2=false

# =============================================================================
# Cashfree Secure ID — automated document verification (rider + merchant KYC)
# =============================================================================
# The active env is stored in verification_provider_configs.environment and
# resolved by the provider layer at runtime. These vars only carry the
# credentials + webhook trust.
#
# SAFETY: production keys must never live in backend/.env or backend/.env.local.
# Inject them into the VPS container environment (docker-compose secrets / VPS
# env), so they are absent from every repository copy.
CASHFREE_SANDBOX_CLIENT_ID=
CASHFREE_SANDBOX_CLIENT_SECRET=
# DigiLocker post-consent redirect (must be https://). http://localhost is
# upgraded automatically; set this when using a public tunnel / prod URL.
# Merchant/partner default:
# CASHFREE_DIGILOCKER_REDIRECT_URL=https://partner.gatimitra.com/auth/digilocker-return
# Rider app — dedicated DigiLocker return (not razorpay-checkout):
# CASHFREE_RIDER_DIGILOCKER_REDIRECT_URL=https://api.gatimitra.com/v1/onboarding/digilocker-return
# RSA public key from Cashfree dashboard (2FA → Public Key). ONE quoted line.
# Enables x-cf-signature so verification works without a static egress IP.
# CASHFREE_PUBLIC_AUTH_KEY=
# CASHFREE_PROD_CLIENT_ID=       # set only on VPS
# CASHFREE_PROD_CLIENT_SECRET=   # set only on VPS


# ---------------------------------------------------------------------------
# MERCHANT APP — Review Login OTP Bypass  (Play Store / App Store review ONLY)
# ---------------------------------------------------------------------------
# Lets ONE pre-approved merchant account sign in with a fixed OTP so an app
# reviewer can log in without owning the SIM. (The rider app has its own,
# separate bypass below.) The app is unchanged — it still calls send-otp ->
# verify-otp and receives byte-identical responses, so the client cannot tell
# the bypass is active.
#
# Behaviour when ENABLED and the request phone == REVIEW_LOGIN_PHONE:
#   • send-otp   : seeds REVIEW_LOGIN_FIXED_OTP into the normal OTP store
#                  (same expiry / attempt limits / response) and sends NO SMS.
#   • verify-otp : the code is compared by the SAME existing check, then the
#                  normal pipeline issues the usual JWT / session / merchant
#                  context / roles / audit logs. There is no second auth path.
#
# Security:
#   • DISABLED BY DEFAULT. Setting REVIEW_LOGIN_BYPASS_ENABLED=false instantly
#     restores stock behaviour — no code change, no redeploy of logic.
#   • The fixed OTP is only ever seeded for REVIEW_LOGIN_PHONE, so it can NEVER
#     authenticate any other number (including the customer review number below).
#     The same phone works for merchant AND rider; every other rider/merchant is unaffected.
#   • Rate limiting, throttling, OTP expiry and abuse protection are untouched.
#   • Every use is logged server-side (event: review_login_bypass, surface: partner,
#     appType: merchant|rider)
#     with only the last 4 phone digits — never exposed in an API response.
#
# KEEP DISABLED DURING NORMAL PRODUCTION OPERATION. Turn on only for an active
# store review, then switch it back off.
REVIEW_LOGIN_BYPASS_ENABLED=false
REVIEW_LOGIN_PHONE=7367878981
REVIEW_LOGIN_FIXED_OTP=123456

# ---------------------------------------------------------------------------
# RIDER APP — Review Login OTP Bypass  (Play Store / App Store review ONLY)
# ---------------------------------------------------------------------------
# Same mechanics as the merchant block above, for the RIDER app and its OWN
# review number. Completely independent: separate flag, phone, OTP; enabling or
# rotating it cannot affect merchant or customer. The rider app signs in through
# the same backend OTP endpoints, so verify's appType routes to the rider
# profile / onboarding / KYC pipeline. The fixed OTP is only ever seeded for
# RIDER_REVIEW_LOGIN_PHONE, so it can never authenticate any other number.
# KEEP DISABLED except during an active rider-app review.
RIDER_REVIEW_LOGIN_BYPASS_ENABLED=false
RIDER_REVIEW_LOGIN_PHONE=9113194305
RIDER_REVIEW_LOGIN_FIXED_OTP=123456

# ---------------------------------------------------------------------------
# CUSTOMER APP — Review Login OTP Bypass
# ---------------------------------------------------------------------------
# Same mechanics as the merchant block above, for the CUSTOMER app and a
# DIFFERENT review phone. The two are completely independent: separate flag,
# separate phone, separate OTP, and neither falls back to the other. Enabling or
# rotating one has no effect on the other.
GOOGLE_REVIEW_MODE=false
GOOGLE_REVIEW_PHONE=
GOOGLE_REVIEW_OTP=

# ---------------------------------------------------------------------------
# Active saved-address retention (customer app location reconcile)
# ---------------------------------------------------------------------------
# Keep the bound Saved Address when live GPS is within this many meters.
# If unset, backend defaults to 500. Override locally / in deploy as needed.
ACTIVE_SAVED_ADDRESS_RETENTION_RADIUS_M=300
