## Backend machine-specific overrides (example)
## Copy to `backend/.env.local` and fill values.
##
## NOTE: Keep real secrets out of git.

# Firebase Admin (backend-only)
# Create a service account JSON in Firebase console and copy fields below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# IMPORTANT: store with literal \n for newlines, example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# MSG91 (backend-only)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Postgres pool + HTTP DB slot limit (one slot per in-flight API request).
DATABASE_POOL_MAX=20
# DATABASE_SLOT_ACQUIRE_TIMEOUT_MS=25000

# Same value as partnersite/dashboard BACKEND_SCHEDULE_TICK_SECRET.
# Protects internal routes: schedule-tick, sync-acceptance-timeout, partner-status,
# notification campaign proxies, dead-token + delivery-status reports.
BACKEND_SCHEDULE_TICK_SECRET=

# Push delivery: 0 = inline Expo (default, reliable without worker); 1 = Redis queue.
PUSH_USE_QUEUE=0
NOTIFICATIONS_V2_ENABLED=true

# Preferred Firebase Admin credential (file path). Alternative to the trio above.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/serviceAccountKey.json
# FCM_SERVICE_ACCOUNT_JSON=

# DigiLocker HTTPS returns (not razorpay-checkout / payment)
# CASHFREE_DIGILOCKER_REDIRECT_URL=https://partner.gatimitra.com/auth/digilocker-return
# CASHFREE_RIDER_DIGILOCKER_REDIRECT_URL=https://api.gatimitra.com/v1/onboarding/digilocker-return
