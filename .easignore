# ============================================================
# Root .easignore - reduces EAS upload size for ALL app builds
# ============================================================

# Other apps - not needed for customer_app build
apps/merchant_app/
apps/gatimitra-riderApp/

# Backend and dashboard - never needed for mobile builds
backend/
dashboard/
merchant_db/
dashboards/

# Native build outputs - generated fresh on EAS
apps/customer_app/android/
apps/customer_app/ios/
apps/customer_app/.expo/
apps/customer_app/dist/
apps/customer_app/build/

# Docs, schemas, and markdown
**/docs/
**/documentation/
**/drizzle/meta/
**/drizzle/*.sql
**/drizzle/fixes/
**/drizzle/documentation/

# Git and IDE
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts and caches
**/dist/
**/build/
**/out/
**/.next/
**/.expo/
**/.gradle/
**/.cache/
**/tmp/
**/temp/
**/logs/
*.log
*.tgz
*.zip
*.tar.gz
*.apk
*.aab
*.ipa
*.keystore

# Test and coverage
**/__tests__/
**/*.test.*
**/*.spec.*
**/coverage/
**/.nyc_output/

# Environment files (use EAS secrets instead)
**/.env
**/.env.*
!**/.env.example

# OS junk
.DS_Store
Thumbs.db

# Large archive outputs from rider app
apps/gatimitra-riderApp/archive-output/
