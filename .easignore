# ============================================================
# Root .easignore - reduces EAS upload size for ALL app builds
# ============================================================

# IMPORTANT: Never exclude apps/gatimitra-riderApp/ — EAS monorepo builds need
# apps/gatimitra-riderApp/package.json in the archive (project root on expo.dev).
# Other apps are excluded per-app via apps/<app>/.easignore when building that app.

# Rider native dirs — EAS must run prebuild (new icons, Mapbox, expo modules).
apps/gatimitra-riderApp/android/
apps/gatimitra-riderApp/ios/

# Backend and dashboard - never needed for mobile builds
backend/
dashboard/
merchant_db/
dashboards/

# Native build outputs - generated fresh on EAS
apps/customer_app/android/
apps/customer_app/ios/
apps/customer_app/.expo/
apps/customer_app/dist/
apps/customer_app/build/

# Docs, schemas, and markdown
**/docs/
**/documentation/
**/drizzle/meta/
**/drizzle/*.sql
**/drizzle/fixes/
**/drizzle/documentation/

# Git and IDE
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts and caches
**/dist/
**/build/
**/out/
**/.next/
**/.expo/
**/.gradle/
**/.cache/
**/tmp/
**/temp/
**/logs/
*.log
*.tgz
*.zip
*.tar.gz
*.apk
*.aab
*.ipa
*.keystore

# Test and coverage
**/__tests__/
**/*.test.*
**/*.spec.*
**/coverage/
**/.nyc_output/

# Environment files (use EAS secrets instead)
**/.env
**/.env.*
!**/.env.example

# OS junk
.DS_Store
Thumbs.db

# Large archive outputs from rider app
apps/gatimitra-riderApp/archive-output/

# ============================================================
# Re-includes (MUST come after the ignore rules above to override them)
# ============================================================
# Shared workspace packages (@gatimitra/*) resolve to packages/<pkg>/dist and are
# committed. The blanket "**/dist/" above strips them from the EAS upload, which
# breaks the Metro bundle ("@gatimitra/merchant-payout ... dist/index.js does not
# exist"). Re-include the package build outputs (directory first, then contents).
!packages/*/dist/
!packages/*/dist/**
