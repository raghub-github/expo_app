{
  "expo": {
    "name": "GatiMitra",
    "slug": "gatimitra-customer",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gatimitra",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-brand.png",
      "resizeMode": "cover",
      "backgroundColor": "#14b8a6",
      "android": {
        "image": "./assets/images/splash-android12.png",
        "resizeMode": "contain",
        "backgroundColor": "#14b8a6"
      },
      "ios": {
        "image": "./assets/images/splash-brand.png",
        "resizeMode": "cover",
        "backgroundColor": "#5eead4"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "androidStatusBar": {
      "hidden": false,
      "translucent": true,
      "backgroundColor": "#14b8a6",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#14b8a6",
      "barStyle": "light-content",
      "visible": "visible"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatimitra.customer",
      "icon": "./assets/icon.png"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.gatimitra.customer",
      "softwareKeyboardLayoutMode": "resize",
      "useNextNotificationsApi": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withAndroidUpiQueries",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GatiMitra uses your location to show nearby restaurants and delivery options."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "GatiMitra needs access to your contacts to add a guest for the ride."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "API_BASE_URL": "${EXPO_PUBLIC_API_BASE_URL}",
      "eas": {
        "projectId": "53fb1df5-d522-4e6a-bc73-04b7ad260992"
      }
    }
  }
}
