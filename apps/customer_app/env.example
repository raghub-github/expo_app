# =============================================================================
# GatiMitra Customer App – Environment
# =============================================================================
# Copy this file to .env or .env.local and set real values.
# Only EXPO_PUBLIC_* variables are included in the app bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# SIGN-IN (required for login/OTP and profile APIs)
# -----------------------------------------------------------------------------
# Backend port must match backend/.env PORT (default 3000).
# EXPO_PUBLIC_API_PORT=3000
#
# Local emulator: http://localhost — Android emulator rewrites this to 10.0.2.2 automatically.
# Physical phone: set your PC LAN IP (same Wi‑Fi):
#   EXPO_PUBLIC_DEV_HOST=192.168.1.5
# Then the app uses http://<IP>:<EXPO_PUBLIC_API_PORT>.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google Maps (Android native tiles + iOS). Create a key in Google Cloud Console
# (Maps SDK for Android / iOS). Required for react-native-maps on Android dev builds.
# After changing this, run: npx expo prebuild --clean && npx expo run:android
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token
# Alias used by rider app — customer app reads this too
# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token

# Supabase — required for phone OTP login (Send SMS hook → MSG91). Same keys for Realtime.
EXPO_PUBLIC_SUPABASE_URL=https://uoxkwznciiibubtiiffh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: force backend POST /v1/auth/otp/request (LAN only). Merchant/rider leave this unset.
# EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true

# =============================================================================
# Quick checklist
# =============================================================================
# 1. backend/: npm run dev — listen on 0.0.0.0:3000 (default).
# 2. Phone: EXPO_PUBLIC_DEV_HOST = PC IP; rebuild app if you changed app.config.js / permissions.
# =============================================================================
