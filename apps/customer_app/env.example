# =============================================================================
# GatiMitra Customer App – Environment
# =============================================================================
# Copy this file to .env or .env.local and set real values.
# Only EXPO_PUBLIC_* variables are included in the app bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# SIGN-IN KE LIYE ZAROORI (Required for successful login/OTP)
# -----------------------------------------------------------------------------
# Backend API base URL – bina trailing slash ke. App yahin OTP request/verify
# bhejegi (POST /v1/auth/otp/request, POST /v1/auth/otp/verify).
# Local (emulator/simulator): http://localhost:3001 is fine (Android emulator auto-uses 10.0.2.2).
# Physical device (real phone): app cannot use localhost (that's the phone). Set EXPO_PUBLIC_DEV_HOST to your PC's IP:
#   EXPO_PUBLIC_DEV_HOST=192.168.1.5
# (Get IP: Windows ipconfig, Mac/Linux ifconfig. Backend must be running on that PC and listen on 0.0.0.0.)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# OPTIONAL (Sign-in ke liye zaroori nahi)
# -----------------------------------------------------------------------------
# Mapbox token – maps / location features ke liye. Sirf map use karenge to set karein.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# Supabase Realtime – store open/closed updates without refresh (Zomato/Swiggy-style).
# Same project as backend. Enable Realtime for table merchant_stores in Supabase Dashboard.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# =============================================================================
# Sign-in flow summary
# =============================================================================
# 1. Customer app me: Sirf EXPO_PUBLIC_API_BASE_URL set karo (backend ka URL).
# 2. Backend (backend/.env) me ye hona chahiye:
#    - DATABASE_URL (Supabase Postgres)
#    - SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET
#    - (Optional) MSG91_AUTH_KEY, MSG91_TEMPLATE_ID – real SMS OTP ke liye;
#      dev me backend response me OTP de deta hai, isliye MSG91 optional hai.
# 3. Backend run karo (e.g. npm run dev in backend/), phir app se login try karo.
# =============================================================================
