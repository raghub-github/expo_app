# Other apps in the monorepo (archive is created from git root)
apps/customer_app/
apps/merchant_app/
backend/
dashboard/
partnersite/
merchant_db/
services/
packages/**/node_modules/

# Force EAS to run expo prebuild (regenerates icons + native config). Never upload stale native dirs.
apps/gatimitra-riderApp/android/
apps/gatimitra-riderApp/ios/
android/
ios/

# Minimal exclusions - only what's absolutely unnecessary
node_modules/
.expo/
.expo-shared/
.gradle/
dist/
build/
out/
.cache/
.next/
tmp/
temp/
logs/
*.log
*.tgz
*.zip
*.tar.gz
*.apk
*.aab
*.ipa
*.keystore
.DS_Store
Thumbs.db

# Documentation files (not needed for build)
*.md
!README.md
# Explicitly exclude deleted documentation files
MAPBOX_FIX.md
MAPBOX_TOKEN_FIX.md

# Environment files
.env*
!env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
__tests__/
*.test.*
*.spec.*

# Coverage reports
coverage/
.nyc_output/