# =============================================================================
# GatiMitra Rider App – Environment (mirror merchant app OTP setup)
# =============================================================================
# Prefer copying `.env.example` → `.env` (same layout as apps/merchant_app/.env.example).
# Use the SAME values as apps/merchant_app/.env.local for Supabase + API URL.
# After changes: npx expo start -c  (clear cache so EXPO_PUBLIC_* reload)
# =============================================================================

# Backend API — physical phone: PC LAN IP (same Wi‑Fi), not localhost
EXPO_PUBLIC_API_BASE_URL=http://192.168.31.82:3000

# Supabase Phone Auth — same project as merchant/customer app
EXPO_PUBLIC_SUPABASE_URL=https://uoxkwznciiibubtiiffh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_from_merchant_app_env

# If SMS does not arrive via Supabase hook, optionally force backend /otp/request (merchant app leaves this unset):
# EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true

# Mapbox (navigation)
# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_token

# WebSocket gateway (optional in local dev)
# EXPO_PUBLIC_WS_BASE_URL=ws://192.168.31.82:4100
# EXPO_PUBLIC_WS_ENABLED=true

# MSG91_* keys belong in backend/.env only — never in the rider app bundle.
