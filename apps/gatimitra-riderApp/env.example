# Copy to .env or .env.local — same Supabase project as customer/merchant apps.
# Only EXPO_PUBLIC_* variables are bundled into the app.

# Backend API (physical device: use PC LAN IP, not localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase Phone Auth — OTP SMS via Send SMS hook → backend MSG91
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: force backend /otp/request instead of Supabase (only if SMS hook fails)
# Local dev on a physical device: route OTP through LAN backend + MSG91 (recommended).
EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true

# Mapbox (navigation)
# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_token

# WebSocket gateway (optional in local dev)
# EXPO_PUBLIC_WS_BASE_URL=ws://localhost:4100
# EXPO_PUBLIC_WS_ENABLED=true
