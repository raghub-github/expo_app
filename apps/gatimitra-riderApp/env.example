# =============================================================================
# GatiMitra Rider App – Environment template
# =============================================================================
# Copy this file to `.env.local` (gitignored, machine-specific) and edit the
# values below. Only EXPO_PUBLIC_* variables are baked into the app bundle —
# never put secrets here.
#
#   cp env.example .env.local
#   npx expo start --clear   ← cache reload is required after changing env
# =============================================================================


# -----------------------------------------------------------------------------
# 🔌 BACKEND API — pick ONE of A/B/C below by uncommenting that single line.
# -----------------------------------------------------------------------------
#
# (A) PRODUCTION backend (default — works out of the box, no local setup):
EXPO_PUBLIC_API_BASE_URL=https://api.gatimitra.com
#
# (B) LOCAL backend, ANDROID EMULATOR (or iOS simulator):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
#
# (C) LOCAL backend, PHYSICAL PHONE on same Wi-Fi:
#     Replace YOUR_LAN_IP with your PC's IP (run `ipconfig` on Windows).
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:3000
#
# How to switch: comment the current line (add `#`), uncomment the desired one,
# then restart Metro with `npx expo start --clear`. The src/config/env.ts
# falls back to https://api.gatimitra.com if no value is set.
#
# Builds for Play Store: EAS production profile (eas.json) forces the prod URL.


# -----------------------------------------------------------------------------
# 🛰  WebSocket gateway (ws-gateway — live dispatch offers when on duty)
# -----------------------------------------------------------------------------
# Production: wss://ws.gatimitra.com (default if EXPO_PUBLIC_API_BASE_URL is prod).
# Local dev: derived from API URL (replaces port 3000 → 4100 automatically).
# Override only if your ws-gateway is on a different host/port:
# EXPO_PUBLIC_WS_BASE_URL=ws://YOUR_LAN_IP:4100
# EXPO_PUBLIC_WS_ENABLED=true       ← set to false if running backend-only locally


# -----------------------------------------------------------------------------
# 🛰  Supabase (same project as customer/merchant — for Realtime Pub/Sub)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://mjfnzmepmeqemcoakjkw.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here


# -----------------------------------------------------------------------------
# 📞 OTP provider
# -----------------------------------------------------------------------------
# Rider config layer only supports "msg91" (backend /otp/request + /otp/verify).
EXPO_PUBLIC_OTP_PROVIDER=msg91
# If Supabase Send SMS hook is misconfigured, force backend OTP path:
# EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true


# -----------------------------------------------------------------------------
# 🔥 Firebase (push notifications + optional Firebase Phone Auth fallback)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=


# -----------------------------------------------------------------------------
# 🗺  Mapbox
# -----------------------------------------------------------------------------
# Public token — safe to ship in bundle; restrict by bundle ID in Mapbox dash.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
# Secret token read by Gradle at native build time (NOT shipped in JS bundle).
# Needed by @rnmapbox/maps to fetch the SDK from Mapbox during `expo prebuild`.
RNMAPBOX__MAPS_DOWNLOAD_TOKEN=sk.YOUR_MAPBOX_DOWNLOAD_TOKEN


# -----------------------------------------------------------------------------
# 💳 Razorpay (public key only — secret + webhook stay in backend/.env)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx


# =============================================================================
# Quick checklist
# =============================================================================
# 1. Pick A/B/C above based on whether you're testing against prod or local backend.
# 2. If using LOCAL backend (B/C), run the backend first:
#       cd backend && npm run dev      ← listens on 0.0.0.0:3000
#    Plus ws-gateway if you need live dispatch:
#       cd services/ws-gateway && npm run dev
# 3. Phone on same Wi-Fi as PC → use option (C). Phone on cellular → use (A).
# 4. After any change to this file: `npx expo start --clear` so Metro reloads.
# 5. Note: MSG91_* + RAZORPAY_KEY_SECRET belong in backend/.env, never here.
# =============================================================================
