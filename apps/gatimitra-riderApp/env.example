# gatimitra-riderApp (Expo) — copy to .env (committed to .gitignore).
# Anything prefixed EXPO_PUBLIC_ is baked into the JS bundle at build time.
# Treat them as PUBLIC — never put secrets here.

# Backend API (physical device: use PC LAN IP, not localhost; emulator: 10.0.2.2)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Supabase (anon key only — safe to ship in client)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OTP provider — only "msg91" is supported in the rider config layer.
EXPO_PUBLIC_OTP_PROVIDER=msg91

# Optional: force backend /otp/request instead of Supabase (only if SMS hook fails)
# Local dev on a physical device: route OTP through LAN backend + MSG91 (recommended).
EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true

# Firebase (used only for Firebase Phone Auth + push-notification token)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mapbox — public token (sk_… secret tokens MUST NOT go here).
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
# Used by @rnmapbox/maps at native build time to fetch the SDK from Mapbox.
# This one IS a secret (sk_…) and is read by Gradle, NOT shipped in the JS bundle.
RNMAPBOX__MAPS_DOWNLOAD_TOKEN=sk.YOUR_MAPBOX_DOWNLOAD_TOKEN

# Razorpay — used inside react-native-razorpay's checkout UI on Android.
# Rider app calls /v1/payments on backend; key here is only the public key_id.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WebSocket gateway (optional in local dev)
# EXPO_PUBLIC_WS_BASE_URL=ws://localhost:4100
# EXPO_PUBLIC_WS_ENABLED=true
