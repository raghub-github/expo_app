# Copy to .env or .env.local and fill in (same Supabase project as merchant / customer app).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# If SMS does not arrive via Supabase (hook/MSG91), optionally force backend POST /v1/auth/otp/request.
# Merchant app leaves this unset — Supabase signInWithOtp is the default path.
# EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true

# Mapbox (navigation — optional for login, required for live maps)
# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_token

# Realtime dispatch (optional in local dev)
# EXPO_PUBLIC_WS_BASE_URL=ws://192.168.31.82:4100
# EXPO_PUBLIC_WS_ENABLED=true

# MSG91_* keys belong in backend/.env only — never in the rider app bundle.
