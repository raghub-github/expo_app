# GatiMitra Merchant App – environment variables
# Copy to .env. Only EXPO_PUBLIC_* are included in the app bundle.
#
# Backend: merchant portal uses the same backend as the monorepo.
# Set EXPO_PUBLIC_API_BASE_URL to match backend/.env API_BASE_URL (or PORT).
# Example: backend/.env has API_BASE_URL=http://localhost:3000 and PORT=3000.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Physical device: use your PC's IP so the phone can reach the backend:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:3000

# Supabase Phone Auth — same project as dashboard / partnersite (required for OTP verify exchange).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# If SMS does not arrive via Supabase (hook/MSG91), use backend POST /v1/auth/otp/request.
EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true

# Share Restaurant: base URL for shareable store links (deep link). Opens store in customer app when installed, else in web.
# EXPO_PUBLIC_STORE_WEB_BASE_URL=https://www.gatimitra.com

# Google Sign-In: Web Client ID from Google Cloud Console (same as backend GOOGLE_CLIENT_ID).
# Add your redirect URI (from app) to Google Console → APIs & Services → Credentials → Web client → Authorized redirect URIs.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
