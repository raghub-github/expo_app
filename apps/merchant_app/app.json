{
  "expo": {
    "name": "GatiMitra Merchant",
    "slug": "gatimitra-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gatimitra-merchant",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/onlylogo.png",
    "splash": {
      "image": "./assets/wlcm.png",
      "backgroundColor": "#16A34A"
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatimitra.merchant",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/onlylogo.png",
        "backgroundColor": "#16A34A"
      },
      "package": "com.anonymous.gatimitramerchantapp",
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-floating-bubble",
      [
        "expo-notifications",
        {
          "icon": "./assets/onlylogo.png",
          "color": "#3EB489",
          "sounds": [],
          "defaultChannel": "merchant_default"
        }
      ]
    ]
  }
}
