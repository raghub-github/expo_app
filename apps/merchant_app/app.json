{
  "expo": {
    "name": "GatiMitra Merchant",
    "slug": "gatimitra-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gatimitra-merchant",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#16A34A"
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatimitra.merchant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A34A"
      },
      "package": "com.gatimitra.merchant",
      "permissions": ["READ_SMS", "RECEIVE_SMS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-font"]
  }
}
