{
  "expo": {
    "name": "GatiMitra Partner",
    "slug": "merchantapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gatimitra-merchant",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/splash-logo.png",
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B241C"
    },
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#0B241C",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatimitra.merchant",
      "icon": "./assets/images/splash-logo.png",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-logo.png",
        "backgroundColor": "#0B241C"
      },
      "icon": "./assets/images/splash-logo.png",
      "package": "com.gatimitra.partner",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "2a277edd-b33f-4f8b-a5ae-c7d4477b3534"
      }
    }
  }
}
