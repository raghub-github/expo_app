# Copy to .env and fill in (same Supabase project as dashboard / partnersite).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# If SMS does not arrive via Supabase (hook/MSG91), use the same OTP path as the customer app:
# backend POST /v1/auth/otp/request with MSG91_AUTH_KEY on the API server. On a physical device,
# set EXPO_PUBLIC_API_BASE_URL to your PC LAN IP (e.g. http://192.168.31.82:3000), not localhost.
EXPO_PUBLIC_PHONE_OTP_USE_BACKEND=true
