# payment-worker — copy to services/payment-worker/.env
#
# Consumes the q.payment.reconcile + q.payment.webhook-retry queues. Calls
# back into the backend's /v1/internal/payments/* endpoints to settle
# Razorpay state, so the shared secret must match backend's INTERNAL_API_TOKEN.

# Standard
NODE_ENV=development

# Redis (BullMQ broker)
REDIS_URL=redis://127.0.0.1:6379

# Where the backend is reachable from inside the docker network. In prod
# compose this is http://backend:3000.
BACKEND_INTERNAL_URL=http://127.0.0.1:3000

# Shared secret presented on /v1/internal/* calls. MUST match
# INTERNAL_API_TOKEN in backend/.env or backend rejects with 503.
INTERNAL_API_TOKEN=change-me-to-match-backend

# How often the legacy in-band reconciler tick is allowed to fire (seconds).
# Worker honours this when polling for stalled payments.
PAYMENT_RECONCILER_INTERVAL_SEC=60
