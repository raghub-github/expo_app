# eta-worker â€” copy to services/eta-worker/.env
#
# Consumes the q.eta.recalc queue. Calls backend /v1/eta/orders/:id/recalc
# to update ETA when traffic / order-state / weather signals change.

# Standard
NODE_ENV=development

# Redis (BullMQ broker)
REDIS_URL=redis://127.0.0.1:6379

# Backend reachability inside the docker network (prod: http://backend:3000)
BACKEND_INTERNAL_URL=http://10.106.243.181:3000

# Shared secret for /v1/internal/* â€” MUST match backend's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=change-me-to-match-backend
