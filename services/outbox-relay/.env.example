# outbox-relay — copy to services/outbox-relay/.env
#
# Polls event_outbox rows where published_at IS NULL with FOR UPDATE SKIP
# LOCKED, then publishes them to Kafka (or falls back to a Redis stream
# `gm.events` when KAFKA_BROKERS is empty). Idempotent — a relay crash
# mid-publish results in at-least-once delivery; consumers must dedupe.

# Standard
NODE_ENV=development

# Postgres (same as backend; use Supabase pooler URL in prod).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Redis — used both for the SKIP LOCKED lock coordination AND as the
# Kafka fallback stream.
REDIS_URL=redis://127.0.0.1:6379

# Kafka brokers (comma-separated). LEAVE EMPTY to use the Redis stream
# fallback — fine for single-node deploys. Production with multiple
# consumers should point at a real cluster: "kafka-1:9092,kafka-2:9092".
KAFKA_BROKERS=

# How many outbox rows to claim per tick. Higher = better throughput,
# but raises latency under transient broker failure.
BATCH_SIZE=100

# Poll cadence (ms). Lower = lower event-emit latency, higher Redis QPS.
POLL_INTERVAL_MS=2000
