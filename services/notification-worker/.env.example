# notification-worker — copy to services/notification-worker/.env
#
# Consumes the q.push.send BullMQ queue and dispatches Expo push tokens
# in batches of 100. Stateless: scaling = run more replicas of this image.

# Standard
NODE_ENV=development

# Redis (BullMQ broker; same instance the backend enqueues to)
REDIS_URL=redis://127.0.0.1:6379

# How many push jobs to process in parallel. Bump if CPU is idle and Expo
# accepts > 100 reqs/s in your region.
WORKER_CONCURRENCY=4
