# notification-worker â€” copy to services/notification-worker/.env
#
# Only needed when backend PUSH_USE_QUEUE=1. Default campaign path sends Expo
# inline from the backend and does not require this worker.
#
# Consumes BullMQ queue q.push.send and reports delivery/dead-tokens back
# to the backend.

NODE_ENV=development

# Same Redis as backend REDIS_URL
REDIS_URL=redis://127.0.0.1:6379

# Backend base URL (no trailing slash) â€” for dead-token + delivery-status reports
BACKEND_URL=http://10.168.39.181:3000

# Must match backend BACKEND_SCHEDULE_TICK_SECRET (header X-Internal-Secret)
BACKEND_SCHEDULE_TICK_SECRET=

# Optional — same as backend EXPO_ACCESS_TOKEN (higher Expo rate limits)
EXPO_ACCESS_TOKEN=
