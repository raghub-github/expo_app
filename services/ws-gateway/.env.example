# ws-gateway local dev — copy to services/ws-gateway/.env
# JWT_SECRET MUST match backend SUPABASE_JWT_SECRET (ws-ticket signing).

PORT=4100
JWT_SECRET=copy_from_backend_SUPABASE_JWT_SECRET
# Optional during JWT rotation (same as backend):
# JWT_SECRET_PREVIOUS=

# Local Redis (Memurai / WSL / Docker on 6379)
REDIS_URL=redis://127.0.0.1:6379
